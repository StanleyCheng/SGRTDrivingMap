# LTA DataMall account key (Land Transport Authority, Singapore)
# Used server-side only, to fetch live traffic images (Traffic-Imagesv2).
DATAMALL_ACCOUNT_KEY=your_account_key_here

# Optional MapLibre style URL. If unset or unreachable, standard OpenStreetMap tiles are used.
# NEXT_PUBLIC_MAP_STYLE=https://example.com/maplibre-style.json
